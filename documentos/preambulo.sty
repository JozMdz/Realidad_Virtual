\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{preambulo}[2026/11/24 Estilo comun de los documentos de la materia]

% Formato tomado de la plantilla de tesis del autor.

% --- Papel y margenes ------------------------------------------------------
\RequirePackage[paperwidth=17cm, paperheight=22.5cm, bottom=2.5cm, right=2.5cm]{geometry}

% --- Idioma y codificacion -------------------------------------------------
\RequirePackage[spanish]{babel}
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}

% --- Matematica ------------------------------------------------------------
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{amsthm}
\RequirePackage{commath}
\DeclareMathOperator*{\argmin}{arg\,min}

% --- Listas, columnas, tablas y figuras ------------------------------------
\RequirePackage{enumerate}
\RequirePackage{multicol}
\RequirePackage{multirow}
\RequirePackage{booktabs}
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{caption}
\RequirePackage{subcaption}
\graphicspath{{figuras/}}

% Tablas numeradas en romanos, como en la plantilla
\renewcommand{\thetable}{\Roman{table}}
\addto\captionsspanish{\renewcommand{\tablename}{Tabla}}
\addto\captionsspanish{\renewcommand{\listtablename}{Índice de tablas}}

% --- Algoritmos ------------------------------------------------------------
\RequirePackage{algorithm}
\RequirePackage{algpseudocode}
\renewcommand{\algorithmicrequire}{\textbf{Input:}}
\renewcommand{\algorithmicensure}{\textbf{Output:}}
\floatname{algorithm}{Algoritmo}
\renewcommand{\listalgorithmname}{Índice de algoritmos}

% --- Codigo ----------------------------------------------------------------
\RequirePackage{xcolor}
\definecolor{fondocodigo}{HTML}{F5F5F5}
\definecolor{acento}{HTML}{1F4E79}
\RequirePackage{listings}
\lstset{
  language=Python,
  basicstyle=\ttfamily\footnotesize,
  backgroundcolor=\color{fondocodigo},
  keywordstyle=\color{acento}\bfseries,
  commentstyle=\color{gray}\itshape,
  stringstyle=\color{teal},
  breaklines=true,
  frame=single,
  rulecolor=\color{gray!40},
  showstringspaces=false,
  captionpos=b,
  literate={á}{{\'a}}1 {é}{{\'e}}1 {í}{{\'i}}1 {ó}{{\'o}}1 {ú}{{\'u}}1
           {ñ}{{\~n}}1 {Á}{{\'A}}1 {É}{{\'E}}1 {Í}{{\'I}}1 {Ó}{{\'O}}1 {Ú}{{\'U}}1
}

% --- Indices y enlaces -----------------------------------------------------
\RequirePackage{tocloft}
\RequirePackage[nottoc]{tocbibind}
\RequirePackage{verbatim}
\RequirePackage{xurl}
\RequirePackage[pdftex,
            pdfauthor={José Méndez},
            pdfproducer={Latex con hyperref},
            pdfcreator={pdflatex}]{hyperref}
\urlstyle{same}

% --- Bibliografia APA ------------------------------------------------------
\RequirePackage{csquotes}
\RequirePackage[style=apa,backend=biber,uniquename=init,giveninits=true]{biblatex}
\DeclareLanguageMapping{spanish}{spanish-apa}

% --- Encabezado y pie: solo numero de pagina abajo a la derecha -------------
\RequirePackage{fancyhdr}
\fancyhf{}
\fancyfoot[R]{\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{
  \fancyhf{}
  \fancyfoot[R]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
}
\pagestyle{fancy}

% --- Portada: \portada{titulo}{materia} ------------------------------------
\newcommand{\portada}[2]{%
  \begin{titlepage}
    \begin{center}
      \vspace*{4cm}
      \parbox{\textwidth}{\centering\baselineskip=2.2em\textsc{\Large\textbf{#1}}}\\[3em]
      \textsc{\large #2}\\[3em]
      \textsc{\Large José Méndez}\\[2em]
      \textsc{\large \today}
    \end{center}
    \vspace*{\fill}
  \end{titlepage}
}
